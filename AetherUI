                        BorderSizePixel = 0,
                        Size = UDim2.new(0, 10, 0, 10),
                        Position = UDim2.new(0.5, -5, 0.5, -5),
                        ZIndex = 102
                    })
                    
                    Create("UICorner", {
                        CornerRadius = UDim.new(1, 0),
                        Parent = svKnob
                    })
                    
                    Create("UIStroke", {
                        Color = Color3.new(0,0,0),
                        Thickness = 1.5,
                        Parent = svKnob
                    })
                    
                    local h, s, v = ColorPicker.Value:ToHSV()
                    
                    local function UpdateColor()
                        local newColor = Color3.fromHSV(h, s, v)
                        ColorPicker.Value = newColor
                        preview.BackgroundColor3 = newColor
                        svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                        if colorData.Callback then
                            colorData.Callback(newColor)
                        end
                    end
                    
                    local function SetHue(y)
                        h = 1 - math.clamp((y - hueFrame.AbsolutePosition.Y) / hueFrame.AbsoluteSize.Y, 0, 1)
                        hueKnob.Position = UDim2.new(0, -2, 1 - h, 0)
                        UpdateColor()
                    end
                    
                    local function SetSV(x, y)
                        s = math.clamp((x - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
                        v = 1 - math.clamp((y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
                        svKnob.Position = UDim2.new(s, -5, 1 - v, -5)
                        UpdateColor()
                    end
                    
                    -- Initialize positions
                    hueKnob.Position = UDim2.new(0, -2, 1 - h, 0)
                    svKnob.Position = UDim2.new(s, -5, 1 - v, -5)
                    
                    local draggingHue, draggingSV = false, false
                    
                    hueFrame.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = true
                            SetHue(input.Position.Y)
                        end
                    end)
                    
                    svFrame.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = true
                            SetSV(input.Position.X, input.Position.Y)
                        end
                    end)
                    
                    UserInputService.InputChanged:Connect(function(input)
                        if draggingHue then
                            SetHue(input.Position.Y)
                        elseif draggingSV then
                            SetSV(input.Position.X, input.Position.Y)
                        end
                    end)
                    
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingHue = false
                            draggingSV = false
                        end
                    end)
                    
                    -- Close button
                    local closePicker = Create("TextButton", {
                        Parent = pickerGui,
                        BackgroundColor3 = theme.Primary,
                        BorderSizePixel = 0,
                        Position = UDim2.new(0, 10, 1, -35),
                        Size = UDim2.new(1, -20, 0, 28),
                        Font = Enum.Font.GothamBold,
                        Text = "Done",
                        TextColor3 = Color3.new(1,1,1),
                        TextSize = 13,
                        ZIndex = 101
                    })
                    
                    Create("UICorner", {
                        CornerRadius = UDim.new(0, 6),
                        Parent = closePicker
                    })
                    
                    closePicker.MouseButton1Click:Connect(function()
                        Tween(pickerGui, {Size = UDim2.new(0, 220, 0, 0)}, 0.2, nil, nil, function()
                            pickerGui:Destroy()
                            pickerOpen = false
                        end)
                    end)
                    
                    Tween(pickerGui, {Size = UDim2.new(0, 220, 0, 210)}, 0.25, Enum.EasingStyle.Quart)
                end)
                
                ColorPicker.Set = function(self, color)
                    self.Value = color
                    preview.BackgroundColor3 = color
                    if colorData.Callback then
                        colorData.Callback(color)
                    end
                end
                
                return ColorPicker
            end
            
            -- Label
            function Section:CreateLabel(text)
                local theme = GetTheme()
                local lbl = Create("TextLabel", {
                    Name = "Label",
                    Parent = self.Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 20),
                    Font = Enum.Font.Gotham,
                    Text = text or "",
                    TextColor3 = theme.TextDim,
                    TextSize = 12,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                return lbl
            end
            
            -- Divider
            function Section:CreateDivider()
                local theme = GetTheme()
                local div = Create("Frame", {
                    Name = "Divider",
                    Parent = self.Container,
                    BackgroundColor3 = theme.Border,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 1)
                })
                return div
            end
            
            return Section
        end
        
        return Tab
    end
    
    -- Window controls
    function Window:Notify(data)
        AetherUI:Notify(data)
    end
    
    function Window:SetTheme(themeName)
        if AetherUI.Themes[themeName] then
            AetherUI.Config.Theme = themeName
            -- In a full implementation, this would recursively update all elements
            self:Notify({
                Title = "Theme Changed",
                Content = "Switched to " .. themeName .. " theme",
                Type = "Success"
            })
        end
    end
    
    function Window:Destroy()
        Tween(self.GUI.Main, {Size = UDim2.new(0, 0, 0, 0)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In, function()
            self.GUI:Destroy()
        end)
    end
    
    return Window
end


            -- Keybind
            function Section:CreateKeybind(bindData)
                bindData = bindData or {}
                local theme = GetTheme()
                local Keybind = {Value = bindData.Default or "None"}
                
                local bindFrame = Create("Frame", {
                    Name = "Keybind",
                    Parent = self.Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 34)
                })
                
                local label = Create("TextLabel", {
                    Name = "Label",
                    Parent = bindFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0.6, 0, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = bindData.Name or "Keybind",
                    TextColor3 = theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local bindBtn = Create("TextButton", {
                    Name = "Bind",
                    Parent = bindFrame,
                    BackgroundColor3 = theme.Surface,
                    BackgroundTransparency = 0.3,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -90, 0.5, -14),
                    Size = UDim2.new(0, 90, 0, 28),
                    Font = Enum.Font.GothamBold,
                    Text = Keybind.Value,
                    TextColor3 = theme.Primary,
                    TextSize = 12,
                    AutoButtonColor = false
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(0, 6),
                    Parent = bindBtn
                })
                
                local listening = false
                
                bindBtn.MouseButton1Click:Connect(function()
                    listening = true
                    bindBtn.Text = "..."
                    Tween(bindBtn, {BackgroundColor3 = theme.Primary, TextColor3 = Color3.new(1,1,1)}, 0.2)
                end)
                
                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if listening and not gameProcessed then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            listening = false
                            Keybind.Value = input.KeyCode.Name
                            bindBtn.Text = Keybind.Value
                            Tween(bindBtn, {BackgroundColor3 = theme.Surface, TextColor3 = theme.Primary}, 0.2)
                            if bindData.Callback then
                                bindData.Callback(Keybind.Value)
                            end
                        end
                    elseif not listening and input.KeyCode.Name == Keybind.Value and not gameProcessed then
                        if bindData.Callback then
                            bindData.Callback(Keybind.Value)
                        end
                    end
                end)
                
                Keybind.Set = function(self, key)
                    self.Value = key
                    bindBtn.Text = key
                end
                
                return Keybind
            end
            

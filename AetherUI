function AetherUI:Notify(data)
    data = data or {}
    local theme = GetTheme()
    
    if not self.NotificationContainer then
        self.NotificationContainer = Create("ScreenGui", {
            Name = "AetherNotifications",
            Parent = CoreGui,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            ResetOnSpawn = false
        })
        
        self.NotificationList = Create("Frame", {
            Name = "List",
            Parent = self.NotificationContainer,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 320, 1, -20),
            Position = UDim2.new(1, -340, 0, 10),
            ClipsDescendants = false
        })
        
        self.NotificationLayout = Create("UIListLayout", {
            Parent = self.NotificationList,
            Padding = UDim.new(0, 10),
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Top,
            SortOrder = Enum.SortOrder.LayoutOrder
        })
    end
    
    local notif = Create("Frame", {
        Name = "Notification",
        Parent = self.NotificationList,
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 80),
        ClipsDescendants = true
    })
    
    Create("UICorner", {
        CornerRadius = UDim.new(0, AetherUI.Config.CornerRadius),
        Parent = notif
    })
    
    -- Glass effect
    Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.new(0.95, 0.95, 0.98))
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.9),
            NumberSequenceKeypoint.new(1, 1)
        }),
        Rotation = 90,
        Parent = notif
    })
    
    -- Glow border
    local stroke = Create("UIStroke", {
        Color = theme.Primary,
        Transparency = 0.8,
        Thickness = 1.5,
        Parent = notif
    })
    
    -- Icon
    local iconType = data.Type or "Info"
    local iconColor = theme.Primary
    if iconType == "Success" then iconColor = theme.Success
    elseif iconType == "Warning" then iconColor = theme.Warning
    elseif iconType == "Error" then iconColor = theme.Secondary end
    
    local icon = Create("TextLabel", {
        Name = "Icon",
        Parent = notif,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 40, 0, 40),
        Position = UDim2.new(0, 12, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = iconType == "Success" and "✓" or iconType == "Warning" and "!" or iconType == "Error" and "✕" or "i",
        TextColor3 = iconColor,
        TextSize = 24,
        TextXAlignment = Enum.TextXAlignment.Center
    })
    
    -- Title
    Create("TextLabel", {
        Name = "Title",
        Parent = notif,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 0, 22),
        Position = UDim2.new(0, 58, 0, 12),
        Font = Enum.Font.GothamBold,
        Text = data.Title or "Notification",
        TextColor3 = theme.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })
    
    -- Message
    Create("TextLabel", {
        Name = "Message",
        Parent = notif,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -70, 0, 40),
        Position = UDim2.new(0, 58, 0, 34),
        Font = Enum.Font.Gotham,
        Text = data.Content or "",
        TextColor3 = theme.TextDim,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true
    })
    
    -- Progress bar
    local progressHolder = Create("Frame", {
        Name = "ProgressHolder",
        Parent = notif,
        BackgroundColor3 = theme.Border,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 0, 3),
        Position = UDim2.new(0, 10, 1, -8),
        AnchorPoint = Vector2.new(0, 1)
    })
    
    Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = progressHolder
    })
    
    local progress = Create("Frame", {
        Name = "Progress",
        Parent = progressHolder,
        BackgroundColor3 = iconColor,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0)
    })
    
    Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = progress
    })
    
    -- Animation in
    notif.Size = UDim2.new(1, 0, 0, 0)
    notif.BackgroundTransparency = 1
    stroke.Transparency = 1
    
    Tween(notif, {Size = UDim2.new(1, 0, 0, 80), BackgroundTransparency = 0.1}, 0.4)
    Tween(stroke, {Transparency = 0.8}, 0.6)
    
    -- Progress animation
    local duration = data.Duration or 3
    Tween(progress, {Size = UDim2.new(0, 0, 1, 0)}, duration, Enum.EasingStyle.Linear)
    
    -- Auto dismiss
    task.delay(duration + 0.4, function()
        Tween(notif, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1}, 0.3, nil, nil, function()
            notif:Destroy()
        end)
    end)
    
    -- Click to dismiss
    notif.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Tween(notif, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1}, 0.2, nil, nil, function()
                notif:Destroy()
            end)
        end
    end)
end


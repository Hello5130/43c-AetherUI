                local toggleFrame = Create("Frame", {
                    Name = "Toggle",
                    Parent = self.Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 34)
                })
                
                local label = Create("TextLabel", {
                    Name = "Label",
                    Parent = toggleFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -60, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = toggleData.Name or "Toggle",
                    TextColor3 = theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local switchBg = Create("Frame", {
                    Name = "Background",
                    Parent = toggleFrame,
                    BackgroundColor3 = theme.Border,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -50, 0.5, -12),
                    Size = UDim2.new(0, 50, 0, 24),
                    ClipsDescendants = true
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(1, 0),
                    Parent = switchBg
                })
                
                local switchKnob = Create("Frame", {
                    Name = "Knob",
                    Parent = switchBg,
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 3, 0.5, -9),
                    Size = UDim2.new(0, 18, 0, 18)
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(1, 0),
                    Parent = switchKnob
                })
                
                Create("UIStroke", {
                    Color = theme.Border,
                    Thickness = 1,
                    Parent = switchKnob
                })
                
                local function UpdateToggle()
                    if Toggle.Value then
                        Tween(switchBg, {BackgroundColor3 = theme.Primary}, 0.2)
                        Tween(switchKnob, {Position = UDim2.new(1, -21, 0.5, -9)}, 0.2, Enum.EasingStyle.Quart)
                    else
                        Tween(switchBg, {BackgroundColor3 = theme.Border}, 0.2)
                        Tween(switchKnob, {Position = UDim2.new(0, 3, 0.5, -9)}, 0.2, Enum.EasingStyle.Quart)
                    end
                    if toggleData.Callback then
                        toggleData.Callback(Toggle.Value)
                    end
                end
                
                local clickArea = Create("TextButton", {
                    Name = "ClickArea",
                    Parent = toggleFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Text = ""
                })
                
                clickArea.MouseButton1Click:Connect(function()
                    Toggle.Value = not Toggle.Value
                    UpdateToggle()
                end)
                
                if Toggle.Value then
                    UpdateToggle()
                end
                
                Toggle.Set = function(self, value)
                    self.Value = value
                    UpdateToggle()
                end
                
                return Toggle
            end
            
            -- Slider
            function Section:CreateSlider(sliderData)
                sliderData = sliderData or {}
                local theme = GetTheme()
                local Slider = {
                    Value = sliderData.Default or sliderData.Min or 0,
                    Min = sliderData.Min or 0,
                    Max = sliderData.Max or 100,
                    Rounding = sliderData.Rounding or 0
                }
                
                local sliderFrame = Create("Frame", {
                    Name = "Slider",
                    Parent = self.Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 50)
                })
                
                local label = Create("TextLabel", {
                    Name = "Label",
                    Parent = sliderFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0.7, 0, 0, 20),
                    Font = Enum.Font.Gotham,
                    Text = sliderData.Name or "Slider",
                    TextColor3 = theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local valueLabel = Create("TextLabel", {
                    Name = "Value",
                    Parent = sliderFrame,
                    BackgroundColor3 = theme.Surface,
                    BackgroundTransparency = 0.5,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -55, 0, 0),
                    Size = UDim2.new(0, 55, 0, 22),
                    Font = Enum.Font.GothamBold,
                    Text = tostring(Slider.Value),
                    TextColor3 = theme.Primary,
                    TextSize = 13
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(0, 6),
                    Parent = valueLabel
                })
                
                local track = Create("Frame", {
                    Name = "Track",
                    Parent = sliderFrame,
                    BackgroundColor3 = theme.Border,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 0, 35),
                    Size = UDim2.new(1, 0, 0, 6)
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(1, 0),
                    Parent = track
                })
                
                local fill = Create("Frame", {
                    Name = "Fill",
                    Parent = track,
                    BackgroundColor3 = theme.Primary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0.5, 0, 1, 0)
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(1, 0),
                    Parent = fill
                })
                
                local knob = Create("Frame", {
                    Name = "Knob",
                    Parent = track,
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    Position = UDim2.new(0.5, -8, 0.5, -8),
                    Size = UDim2.new(0, 16, 0, 16),
                    ZIndex = 2
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(1, 0),
                    Parent = knob
                })
                
                Create("UIStroke", {
                    Color = theme.Primary,
                    Thickness = 2,
                    Parent = knob
                })
                
                local dragging = false
                
                local function UpdateSlider(input)
                    local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local value = Slider.Min + (pos * (Slider.Max - Slider.Min))
                    value = Round(value, Slider.Rounding)
                    Slider.Value = value
                    
                    Tween(fill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.05)
                    Tween(knob, {Position = UDim2.new(pos, -8, 0.5, -8)}, 0.05)
                    valueLabel.Text = tostring(value)
                    
                    if sliderData.Callback then
                        sliderData.Callback(value)
                    end
                end
                
                knob.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        Tween(knob, {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(knob.Position.X.Scale, -10, 0.5, -10)}, 0.1)
                    end
                end)
                
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        UpdateSlider(input)
                        dragging = true
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateSlider(input)
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                        Tween(knob, {Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(knob.Position.X.Scale, -8, 0.5, -8)}, 0.1)
                    end
                end)
                
                Slider.Set = function(self, value)
                    value = math.clamp(value, self.Min, self.Max)
                    self.Value = value
                    local pos = (value - self.Min) / (self.Max - self.Min)
                    Tween(fill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.2)
                    Tween(knob, {Position = UDim2.new(pos, -8, 0.5, -8)}, 0.2)
                    valueLabel.Text = tostring(value)
                    if sliderData.Callback then
                        sliderData.Callback(value)
                    end
                end
                
                return Slider
            end
            
            -- Dropdown
            function Section:CreateDropdown(dropData)
                dropData = dropData or {}
                local theme = GetTheme()
                local Dropdown = {
                    Value = dropData.Default or nil,
                    Options = dropData.Options or {},
                    Open = false
                }
                
                local dropFrame = Create("Frame", {
                    Name = "Dropdown",
                    Parent = self.Container,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 40),
                    ClipsDescendants = true
                })
                
                local label = Create("TextLabel", {
                    Name = "Label",
                    Parent = dropFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 20),
                    Font = Enum.Font.Gotham,
                    Text = dropData.Name or "Dropdown",
                    TextColor3 = theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local box = Create("TextButton", {
                    Name = "Box",
                    Parent = dropFrame,
                    BackgroundColor3 = theme.Surface,
                    BackgroundTransparency = 0.3,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 0, 22),
                    Size = UDim2.new(1, 0, 0, 34),
                    Font = Enum.Font.Gotham,
                    Text = Dropdown.Value or "Select...",
                    TextColor3 = Dropdown.Value and theme.Text or theme.TextDim,
                    TextSize = 13,
                    AutoButtonColor = false,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(0, 8),
                    Parent = box
                })
                
                Create("UIPadding", {
                    Parent = box,
                    PaddingLeft = UDim.new(0, 12)
                })
                
                local arrow = Create("TextLabel", {
                    Name = "Arrow",
                    Parent = box,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -30, 0, 0),
                    Size = UDim2.new(0, 30, 1, 0),
                    Font = Enum.Font.GothamBold,
                    Text = "▼",
                    TextColor3 = theme.TextDim,
                    TextSize = 10
                })
                
                local optionsFrame = Create("Frame", {
                    Name = "Options",
                    Parent = dropFrame,
                    BackgroundColor3 = theme.Surface,
                    BackgroundTransparency = 0.1,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 0, 60),
                    Size = UDim2.new(1, 0, 0, 0),
                    ClipsDescendants = true,
                    Visible = false
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(0, 8),
                    Parent = optionsFrame
                })
                
                local optionsList = Create("UIListLayout", {
                    Parent = optionsFrame,
                    Padding = UDim.new(0, 2),
                    SortOrder = Enum.SortOrder.LayoutOrder
                })
                
                local function BuildOptions()
                    for _, child in pairs(optionsFrame:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    
                    for i, option in pairs(Dropdown.Options) do
                        local optBtn = Create("TextButton", {
                            Name = option,
                            Parent = optionsFrame,
                            BackgroundColor3 = theme.Surface,
                            BackgroundTransparency = 1,
                            BorderSizePixel = 0,
                            Size = UDim2.new(1, 0, 0, 32),
                            Font = Enum.Font.Gotham,
                            Text = "   " .. option,
                            TextColor3 = theme.Text,
                            TextSize = 13,
                            AutoButtonColor = false,
                            TextXAlignment = Enum.TextXAlignment.Left
                        })
                        
                        optBtn.MouseEnter:Connect(function()
                            Tween(optBtn, {BackgroundTransparency = 0.5}, 0.15)
                        end)
                        
                        optBtn.MouseLeave:Connect(function()
                            Tween(optBtn, {BackgroundTransparency = 1}, 0.15)
                        end)
                        
                        optBtn.MouseButton1Click:Connect(function()
                            Dropdown.Value = option
                            box.Text = option
                            box.TextColor3 = theme.Text
                            Dropdown.Open = false
                            Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                            Tween(arrow, {Rotation = 0}, 0.2)
                            task.delay(0.2, function()
                                optionsFrame.Visible = false
                                dropFrame.Size = UDim2.new(1, 0, 0, 40)
                            end)
                            if dropData.Callback then
                                dropData.Callback(option)
                            end
                        end)
                    end
                end
                
                BuildOptions()
                
                box.MouseButton1Click:Connect(function()
                    Dropdown.Open = not Dropdown.Open
                    if Dropdown.Open then
                        optionsFrame.Visible = true
                        local height = math.min(#Dropdown.Options * 34, 200)
                        dropFrame.Size = UDim2.new(1, 0, 0, 65 + height)
                        Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, height)}, 0.25, Enum.EasingStyle.Quart)
                        Tween(arrow, {Rotation = 180}, 0.2)
                    else
                        Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                        Tween(arrow, {Rotation = 0}, 0.2)
                        task.delay(0.2, function()
                            optionsFrame.Visible = false
                            dropFrame.Size = UDim2.new(1, 0, 0, 40)
                        end)
                    end
                end)
                
                Dropdown.Refresh = function(self, newOptions)
                    self.Options = newOptions
                    BuildOptions()
                end
                
                Dropdown.Set = function(self, value)
                    self.Value = value
                    box.Text = value
                    box.TextColor3 = theme.Text
                    if dropData.Callback then
                        dropData.Callback(value)
                    end
                end
                
                return Dropdown
            end
            

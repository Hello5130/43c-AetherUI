            -- Button
            function Section:CreateButton(btnData)
                btnData = btnData or {}
                local theme = GetTheme()
                
                local btn = Create("TextButton", {
                    Name = "Button",
                    Parent = self.Container,
                    BackgroundColor3 = theme.Primary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 36),
                    Font = Enum.Font.GothamBold,
                    Text = btnData.Name or "Button",
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 14,
                    AutoButtonColor = false,
                    ClipsDescendants = true
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(0, 8),
                    Parent = btn
                })
                
                -- Glow effect
                local glow = Create("Frame", {
                    Name = "Glow",
                    Parent = btn,
                    BackgroundColor3 = theme.PrimaryGlow,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 1, 0),
                    ZIndex = 0
                })
                
                Create("UICorner", {
                    CornerRadius = UDim.new(0, 8),
                    Parent = glow
                })
                
                btn.MouseEnter:Connect(function()
                    Tween(btn, {BackgroundColor3 = theme.PrimaryGlow}, 0.2)
                    Tween(glow, {BackgroundTransparency = 0.7}, 0.3)
                end)
                
                btn.MouseLeave:Connect(function()
                    Tween(btn, {BackgroundColor3 = theme.Primary}, 0.2)
                    Tween(glow, {BackgroundTransparency = 1}, 0.3)
                end)
                
                btn.MouseButton1Down:Connect(function()
                    Tween(btn, {Size = UDim2.new(0.97, 0, 0, 34)}, 0.1)
                end)
                
                btn.MouseButton1Up:Connect(function()
                    Tween(btn, {Size = UDim2.new(1, 0, 0, 36)}, 0.15, Enum.EasingStyle.Back)
                end)
                
                btn.MouseButton1Click:Connect(function()
                    if btnData.Callback then
                        btnData.Callback()
                    end
                end)
                
                return btn
            end
            
